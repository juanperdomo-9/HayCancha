# Copiá este archivo como .env y completá los valores. Nunca subas el .env al repo.
# Las URLs de Postgres pueden ir como las copia el panel de Supabase (postgresql://...):
# la app las pasa a postgresql+psycopg:// sola.

# --- Desarrollo local (docker compose up -d --wait en la raíz del repo) ---
# App: rol app_user (sujeto a RLS). Después de migrar: uv run python -m app.cli preparar-base
DATABASE_URL=postgresql://app_user:app_user_local@127.0.0.1:5433/haycancha_dev
# Migraciones, superadmin y comandos de app.cli: rol dueño de las tablas.
DATABASE_URL_ADMIN=postgresql://postgres:postgres@127.0.0.1:5433/haycancha_dev
# Base descartable para los tests (pytest la migra sola).
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/haycancha_test

# --- En Supabase (puesta en línea) ---
# DATABASE_URL: pooler en modo transacción (puerto 6543), usuario app_user.REF_DEL_PROYECTO
# DATABASE_URL_ADMIN: pooler en modo sesión (puerto 5432), usuario postgres.REF_DEL_PROYECTO

# URLs públicas
APP_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# Sesiones e invitaciones: 32+ caracteres al azar. Generala con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# true en producción (https): la cookie de sesión viaja solo por https.
COOKIE_SEGURA=false
# Carpeta de logos y portadas (en la puesta en línea pasa a un almacenamiento de archivos).
CARPETA_ARCHIVOS=archivos
# Producción: logos y portadas en Supabase Storage (si están, no se usa la carpeta).
# SUPABASE_URL: Settings > API (https://REF.supabase.co). La clave: Settings > API Keys >
# Secret keys (sb_secret_...). El bucket se crea en Storage > New bucket, marcado Public.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET=archivos

# SOLO DESARROLLO: reservas online sin Mercado Pago, con botón "Simular pago aprobado".
# Nunca en producción.
PAGOS_SIMULADOS=false

# Mercado Pago (fase 2)
# Encripta los tokens de cada complejo. Generala una vez por entorno con:
#   uv run python -m app.cli generar-clave
# Si se pierde o se cambia, todos los complejos tienen que volver a vincular Mercado Pago.
TOKEN_ENCRYPTION_KEY=
# De la app de HayCancha en https://www.mercadopago.com.ar/developers/panel/app
# (Credenciales de producción). En la app hay que habilitar el flujo con PKCE.
MP_CLIENT_ID=
MP_CLIENT_SECRET=
# Tus integraciones > Webhooks > Configurar notificaciones (URL: {APP_BASE_URL}/webhooks/mercadopago,
# evento Pagos). Al guardar, Mercado Pago genera esta clave secreta.
MP_WEBHOOK_SECRET=
# Vacío: {APP_BASE_URL}/mercadopago/callback. Tiene que coincidir con la cargada en la app.
MP_REDIRECT_URI=
# true solo para probar con cuentas de prueba de Mercado Pago (credenciales TEST-).
MP_TOKENS_DE_PRUEBA=false

# Email con Resend (fase 2). Sin clave, los emails solo se muestran en el log.
# resend.com > API Keys > Create API Key (permiso "Sending access").
EMAIL_API_KEY=
# Con el dominio verificado en Resend (Domains). Vacío: onboarding@resend.dev (solo sirve
# para mandarse emails de prueba a uno mismo).
EMAIL_FROM=

# Asistentes de IA (fase 3). API compatible con OpenAI: hoy Groq, plan gratis
# (console.groq.com > API Keys). Para cambiar de proveedor o modelo, cambiar estas tres.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODELO=openai/gpt-oss-120b
