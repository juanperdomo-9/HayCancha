# Copiá este archivo como .env y completá los valores. Nunca subas el .env al repo.
# Las URLs de Postgres pueden ir como las copia el panel de Supabase (postgresql://...):
# la app las pasa a postgresql+psycopg:// sola.

# App: pooler de Supabase en modo transacción (puerto 6543), rol app_user (se crea en la fase 1).
DATABASE_URL=postgresql://app_user.REF_DEL_PROYECTO:CLAVE@HOST_DEL_POOLER:6543/postgres
# Migraciones y superadmin: pooler en modo sesión (puerto 5432), rol dueño de las tablas.
DATABASE_URL_ADMIN=postgresql://postgres.REF_DEL_PROYECTO:CLAVE@HOST_DEL_POOLER:5432/postgres

# Postgres local descartable para los tests (docker compose up -d en la raíz del repo).
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/haycancha_test

# URLs públicas
APP_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# Sesiones (fase 1)
JWT_SECRET=

# Mercado Pago (fase 2)
TOKEN_ENCRYPTION_KEY=
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_WEBHOOK_SECRET=
MP_REDIRECT_URI=

# Email (fase 2, proveedor a definir)
EMAIL_API_KEY=
EMAIL_FROM=

# Asistente (fase 3)
LLM_API_KEY=
