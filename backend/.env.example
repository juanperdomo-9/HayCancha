# Copiá este archivo como .env y completá los valores. Nunca subas el .env al repo.
# Las URLs de Postgres pueden ir como las copia el panel de Supabase (postgresql://...):
# la app las pasa a postgresql+psycopg:// sola.

# --- Desarrollo local (docker compose up -d --wait en la raíz del repo) ---
# App: rol app_user (sujeto a RLS). Después de migrar: uv run python -m app.cli preparar-base
DATABASE_URL=postgresql://app_user:app_user_local@127.0.0.1:5433/haycancha_dev
# Migraciones, superadmin y comandos de app.cli: rol dueño de las tablas.
DATABASE_URL_ADMIN=postgresql://postgres:postgres@127.0.0.1:5433/haycancha_dev
# Base descartable para los tests (pytest la migra sola).
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/haycancha_test

# --- En Supabase (puesta en línea) ---
# DATABASE_URL: pooler en modo transacción (puerto 6543), usuario app_user.REF_DEL_PROYECTO
# DATABASE_URL_ADMIN: pooler en modo sesión (puerto 5432), usuario postgres.REF_DEL_PROYECTO

# URLs públicas
APP_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# Sesiones (fase 1)
JWT_SECRET=

# Mercado Pago (fase 2)
TOKEN_ENCRYPTION_KEY=
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_WEBHOOK_SECRET=
MP_REDIRECT_URI=

# Email (fase 2, proveedor a definir)
EMAIL_API_KEY=
EMAIL_FROM=

# Asistente (fase 3)
LLM_API_KEY=
