# Copiá este archivo como .env.local. Las variables VITE_ quedan públicas en el navegador:
# nunca pongas secretos acá.

# URL del backend (FastAPI).
VITE_API_URL=http://localhost:8000

# Clave de la Maps Embed API de Google (gratis, pero pide proyecto de Google Cloud con
# facturación). Es pública por naturaleza: restringila por dominio (haycancha.com.ar)
# y solo a la Maps Embed API. Sin clave, se muestra un link a Google Maps en lugar del mapa.
VITE_GOOGLE_MAPS_KEY=
