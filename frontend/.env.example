# Copiá este archivo como .env.local. Las variables VITE_ quedan públicas en el navegador:
# nunca pongas secretos acá.

# URL del backend (FastAPI).
VITE_API_URL=http://localhost:8000

# Clave de la Maps Embed API de Google (gratis, pero pide proyecto de Google Cloud con
# facturación). Es pública por naturaleza: restringila por dominio (haycanchas.com.ar)
# y solo a la Maps Embed API. Sin clave, se muestra un link a Google Maps en lugar del mapa.
VITE_GOOGLE_MAPS_KEY=

# Dirección pública de la página, para la vista previa al compartir el link.
# En Render: https://haycanchas.com.ar (y https://haycanchas.com.ar con el dominio).
VITE_SITE_URL=http://localhost:5173
